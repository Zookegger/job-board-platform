{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot App",
            "request": "launch",
            "mainClass": "com.yoedu.job_board_platform.JobBoardPlatformApplication",
            "cwd": "${workspaceFolder}",
            "env": {
                "SPRING_APPLICATION_NAME": "job_board_platform_backend",
                "SERVER_PORT": "5000",
                "DB_URL": "jdbc:postgresql://localhost:5432/job_board_db",
                "DB_USERNAME": "postgres",
                "DB_PASSWORD": "postgres",
                "SPRING_JPA_DATABASE_PLATFORM": "org.hibernate.dialect.PostgreSQLDialect",
                "SPRING_JPA_HIBERNATE_DDL_AUTO": "update",
                "SPRING_JPA_SHOW_SQL": "true",
                "SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL": "true",
                "SPRING_FLYWAY_ENABLED": "true",
                "APP_JWT_SECRET": "012345678901234567890123456789012345678901234567890123456789",
                "APP_JWT_EXPIRATION_MILLIS": "3600000"
            },
            "args": "",
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
