# Copy this file to `.env` and update values for your environment.
# Do NOT commit the real `.env` with secrets.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_board_db
DB_PORT=5432

# Point the app to the docker-compose service name `db` so containers communicate internally
DB_URL=jdbc:postgresql://db:5432/job_board_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Spring Boot server port (container maps this to host via docker-compose)
SERVER_PORT=8080

# JWT settings (replace with a secure secret in production)
APP_JWT_SECRET=replace_this_with_a_secure_jwt_secret
APP_JWT_EXPIRATION_MILLIS=3600000

# Optional: change host port mapping for client if desired
# CLIENT_PORT=3000
